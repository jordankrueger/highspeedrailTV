---
layout: layouts/base.njk
---

<section class="newsletter-issue">
  <div class="container">
    <div class="newsletter-issue-header">
      <a href="/newsletter/" class="newsletter-back">&larr; All issues</a>
      <h1>This Week in High Speed Rail</h1>
      <div class="newsletter-issue-meta">
        <span class="newsletter-issue-badge">{{ title }}</span>
        <span class="newsletter-issue-date">{{ date | dateFormat }}</span>
      </div>
    </div>
    <div class="newsletter-issue-body">
      {{ content | safe }}
    </div>
    <div class="newsletter-issue-footer">
      <div class="newsletter-footer-links">
        <a href="https://hsr.fyi">HSR.fyi</a>
        <a href="https://highspeedrail.tv">HighSpeedRail.TV</a>
        <a href="https://ko-fi.com/highspeedrail">Support on Ko-fi</a>
      </div>
      <p>Know someone who'd like this? Send them to <a href="https://highspeedrail.tv">highspeedrail.tv</a> to subscribe.</p>
      <p class="newsletter-footer-byline">Curated by <a href="https://jordankrueger.com">Jordan Krueger</a>. No ads, no sponsors, just trains.</p>
    </div>
  </div>
</section>
