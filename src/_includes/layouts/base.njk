<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("HighSpeedRail.TV") }} | HighSpeedRail.TV</title>
  <meta name="description" content="{{ description | default("Curated videos about high-speed rail in America and around the world.") }}">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/atom+xml" title="HighSpeedRail.TV Feed" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  {% if site.googleAnalyticsId %}
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.googleAnalyticsId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.googleAnalyticsId }}');
  </script>
  {% endif %}
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo">
        <span class="logo-icon">
          <svg width="34" height="32" viewBox="0 0 34 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 22L7 8H29L27 22H5Z" fill="currentColor"/>
            <path d="M8 19L9.5 10H26.5L25 19H8Z" fill="#1B4D4A"/>
            <path d="M9.5 18L10.5 11H25L24 18H9.5Z" fill="#E07A5F"/>
            <path d="M14 14.5H21M21 14.5L18.5 12M21 14.5L18.5 17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="11" y="23" width="12" height="2" rx="1" fill="currentColor"/>
          </svg>
        </span>
        <span class="logo-text">HighSpeedRail<span class="logo-tv">.TV</span></span>
      </a>
      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/categories/">Categories</a>
        <a href="/newsletter/">Newsletter</a>
        <a href="https://hsr.fyi" target="_blank" rel="noopener">hsr.fyi</a>
      </nav>
    </div>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <!-- Subscribe CTA Section -->
  <section class="subscribe-cta">
    <div class="subscribe-cta-overlay"></div>
    <div class="subscribe-cta-content">
      <h2>Stay on track</h2>
      <p>Get new videos in your inbox. No spam, just trains.</p>
      <form class="subscribe-cta-form" id="newsletter-form" action="https://newsletter.campaign.help/subscription/form" method="post">
        <input type="hidden" name="l" value="cf81b2b8-9980-414d-bf5f-ce8cc1d5aa84">
        <input type="email" name="email" class="subscribe-cta-input" placeholder="Your email address" required>
        <button type="submit" class="subscribe-cta-btn">Subscribe</button>
      </form>
      <p class="subscribe-cta-confirm" id="newsletter-confirm" style="display: none; color: rgba(255,255,255,0.9); font-size: 1rem;">You're subscribed! Welcome aboard.</p>
      <p class="subscribe-cta-error" id="newsletter-error" style="display: none; color: #E07A5F; font-size: 0.9rem;">Something went wrong. Please try again.</p>
      <a href="/feed.xml" class="subscribe-cta-rss">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        or subscribe via RSS
      </a>
    </div>
  </section>
  <script>
    document.getElementById('newsletter-form').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = this;
      var btn = form.querySelector('button');
      var errorEl = document.getElementById('newsletter-error');
      errorEl.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Subscribing...';
      var data = new URLSearchParams(new FormData(form));
      fetch(form.action, { method: 'POST', body: data, mode: 'no-cors' })
        .then(function() {
          form.style.display = 'none';
          document.getElementById('newsletter-confirm').style.display = 'block';
        })
        .catch(function() {
          errorEl.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Subscribe';
        });
    });
  </script>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <svg width="30" height="28" viewBox="0 0 34 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 22L7 8H29L27 22H5Z" fill="currentColor"/>
              <path d="M8 19L9.5 10H26.5L25 19H8Z" fill="#1B4D4A"/>
              <path d="M9.5 18L10.5 11H25L24 18H9.5Z" fill="#E07A5F"/>
              <path d="M14 14.5H21M21 14.5L18.5 12M21 14.5L18.5 17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="11" y="23" width="12" height="2" rx="1" fill="currentColor"/>
            </svg>
            <span>HighSpeedRail.TV</span>
          </a>
          <p>Curated videos about high-speed rail in America and around the world.</p>
        </div>
        <div class="footer-col">
          <h4>Browse</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/categories/">All Categories</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Categories</h4>
          <ul>
            <li><a href="/category/explainers/">Explainers</a></li>
            <li><a href="/category/construction-progress/">Construction Updates</a></li>
            <li><a href="/category/myth-busting/">Myth Busting</a></li>
            <li><a href="/category/international-hsr/">International HSR</a></li>
            <li><a href="/category/rides-tours/">Rides & Tours</a></li>
            <li><a href="/category/advocacy-speeches/">Advocacy</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Network</h4>
          <ul>
            {% for link in settings.footerLinks %}
            <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 HighSpeedRail.TV · Curated by <a href="https://jordankrueger.com">Jordan</a> · <a href="https://ko-fi.com/highspeedrail" class="footer-support-link" target="_blank" rel="noopener">Support this project</a></p>
      </div>
    </div>
  </footer>

  <div class="network-banner">
    <a href="https://hsr.fyi" target="_blank" rel="noopener">
      <span class="network-banner-icon">
        <svg width="20" height="18" viewBox="0 0 34 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 22L7 8H29L27 22H5Z" fill="currentColor"/>
          <path d="M8 19L9.5 10H26.5L25 19H8Z" fill="#1B4D4A"/>
          <path d="M9.5 18L10.5 11H25L24 18H9.5Z" fill="#E07A5F"/>
          <path d="M14 14.5H21M21 14.5L18.5 12M21 14.5L18.5 17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="11" y="23" width="12" height="2" rx="1" fill="currentColor"/>
        </svg>
      </span>
      Part of the hsr.fyi network
    </a>
  </div>

  <script>
    // Lazy load YouTube embeds
    document.addEventListener('DOMContentLoaded', function() {
      const videoCards = document.querySelectorAll('.video-card[data-video-id]');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const card = entry.target;
            const videoId = card.dataset.videoId;
            const placeholder = card.querySelector('.video-placeholder');
            if (placeholder && !placeholder.querySelector('iframe')) {
              placeholder.addEventListener('click', function() {
                const iframe = document.createElement('iframe');
                iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                iframe.allowFullscreen = true;
                placeholder.innerHTML = '';
                placeholder.appendChild(iframe);
              }, { once: true });
            }
            observer.unobserve(card);
          }
        });
      }, { rootMargin: '100px' });

      videoCards.forEach(card => observer.observe(card));
    });
  </script>
</body>
</html>
