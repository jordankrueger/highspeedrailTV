# YouTube Data API Key (required for search)
# Get yours at: https://console.cloud.google.com/
# See YOUTUBE_API_SETUP.md for detailed instructions
YOUTUBE_API_KEY=your_youtube_api_key_here

# Admin Panel Password
ADMIN_PASSWORD=choose_a_secure_password

# Session Secret (optional, will use default if not set)
SESSION_SECRET=random_string_for_session_encryption

# Anthropic API Key (required for AI review feature)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Admin Server Port (optional, defaults to 3000)
ADMIN_PORT=3000
